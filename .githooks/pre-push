#!/usr/bin/env bash
# Block direct pushes to main/master (including force-pushes).
# Rejects any non-delete push targeting protected branches, regardless
# of whether the push is force or fast-forward.
# Install: git config core.hooksPath .githooks  (or: make hooks)
set -euo pipefail

while read -r local_ref local_oid remote_ref _remote_oid; do
  # Skip delete pushes (local_oid is all zeros)
  if [[ "$local_oid" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  # Block pushes to protected branches
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      cat 1>&2 <<ERR
ERROR: Direct push to ${remote_ref#refs/heads/} is blocked.

Use a feature branch and open a pull request instead.
If you are in a worktree, push the worktree branch:
  git push -u origin HEAD

ERR
      exit 1
      ;;
  esac
done

exit 0
