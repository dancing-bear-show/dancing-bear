#!/usr/bin/env python3
"""PR workflow assistant — create, review, resolve, and summarize GitHub PRs.

Usage:
  pr-assistant [options]

Options:
  --create / --no-create            Auto-create PR if missing (default: on)
  --resolve-copilot / --no-resolve-copilot  Resolve Copilot conversations (default: on)
  --check-qlty / --no-check-qlty    Check qlty issues on PR files (default: on)
  --check-ci / --no-check-ci        Check CI/CD status (default: on)
  --update-summary / --no-update-summary  Post summary comment to PR (default: on)
  --base BRANCH                     Base branch for new PRs (default: main)
  --title TEXT                      Override PR title
  --body TEXT                       Override PR description
  --dry-run                         Preview without making changes
"""
import argparse
import importlib.util
import os
import re
import subprocess  # nosec B404 - qlty and git shell-outs use fixed argv; no shell
import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parents[1]

# Load bin/_pathrepair.py by explicit filesystem path, NOT by `import`.
#
# That module's job is to fix a broken import path, so it cannot itself depend
# on the import path being correct: a plain `import` would either fail or —
# far worse — silently load a FOREIGN checkout's copy and repair nothing.
# Anchoring to __file__ also keeps this correct when pr-assistant is invoked
# through a symlink or found on $PATH, since Path.resolve() follows symlinks.
_spec = importlib.util.spec_from_file_location(
    "_dancing_bear_pathrepair", _REPO_ROOT / "bin" / "_pathrepair.py"
)
if _spec is None or _spec.loader is None:  # pragma: no cover - defensive
    raise SystemExit("bin/pr-assistant: cannot load bin/_pathrepair.py")
_pathrepair = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_pathrepair)

# Must run BEFORE the .venv re-exec below so the corrected PYTHONPATH is
# inherited across os.execv.
_pathrepair.strip_foreign_src_paths(_REPO_ROOT)

_VENV_PY = _REPO_ROOT / ".venv" / "bin" / "python3"
_VENV_PY_REAL = os.path.realpath(str(_VENV_PY)) if _VENV_PY.exists() else ""
if (
    _VENV_PY.exists()
    and sys.prefix == sys.base_prefix  # no venv active
    and os.path.realpath(sys.executable) != _VENV_PY_REAL
    and os.environ.get("_DANCING_BEAR_VENV_EXEC") != _VENV_PY_REAL
):
    os.environ["_DANCING_BEAR_VENV_EXEC"] = _VENV_PY_REAL
    os.execv(str(_VENV_PY), [str(_VENV_PY)] + sys.argv)

# After the re-exec, immediately before the first repo import: force our src/ to
# the FRONT of sys.path. A membership test is not enough — if our src/ is on the
# path but sits behind another checkout's, that one wins and the guard is a no-op.
SRC_ROOT = Path(_pathrepair.force_own_src_first(_REPO_ROOT))

from core.github import (  # noqa: E402
    GhError,
    client,
    fetch_review_threads,
    normalize_login,
    resolve_owner_repo,
    resolve_thread,
)
from core.github.pulls import (  # noqa: E402
    pr_checks,
    pr_comment,
    pr_create,
    pr_edit,
    pr_files,
    pr_view,
)


# ---------------------------------------------------------------------------
# Local helpers (git remains a subprocess; qlty stays local)
# ---------------------------------------------------------------------------

def _git(*args):
    """Run a git command, return stdout stripped."""
    result = subprocess.run(  # nosec B603 B607 - fixed argv, no shell, repo-internal use
        ["git", *args],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


# ---------------------------------------------------------------------------
# PR creation / lookup
# ---------------------------------------------------------------------------

def find_pr(gh):
    """Return dict with number, url, headRefName, baseRefName, or None."""
    try:
        return pr_view(
            gh, None, ["number", "url", "headRefName", "baseRefName"]
        )
    except GhError:
        return None


def create_pr(gh, base, title, body, dry_run):
    """Create a PR, return dict with number and url, or None on dry-run/failure."""
    if not title:
        title = _git("rev-parse", "--abbrev-ref", "HEAD")
    body = body or ""
    if dry_run:
        print(f"[DRY RUN] gh pr create --base {base} --title {title}")
        return None
    try:
        pr_create(gh, base=base, title=title, body=body)
    except GhError as exc:
        print(f"Failed to create PR: {exc}", file=sys.stderr)
        return None
    return find_pr(gh)


# ---------------------------------------------------------------------------
# Copilot review threads
# ---------------------------------------------------------------------------

COPILOT_BOT = "copilot-pull-request-reviewer"


def fetch_copilot_threads(gh, owner, repo, pr_number):
    """Return list of unresolved Copilot review threads.

    A thread qualifies when its ``source`` is ``graphql-thread`` (REST review
    bodies and issue comments carry no thread_id and cannot be resolved),
    ``is_resolved`` is false, and its opening author normalises to the Copilot
    login. Now paginated through the full ``reviewThreads`` connection, so
    threads beyond the first 50 are included; the previous first(50) query
    silently dropped them.
    """
    doc, _raw = fetch_review_threads(gh, owner, repo, pr_number)
    if doc.get("truncated"):
        # A count GitHub reported did not match what came back. Resolving from
        # a partial list and then posting "N unresolved" would present an
        # incomplete run as complete, so stop instead.
        raise GhError("review-thread fetch incomplete (reported counts did not match); rerun")
    out = []
    for entry in doc.get("threads") or []:
        if entry.get("source") != "graphql-thread":
            continue
        if entry.get("is_resolved"):
            continue
        opening = (entry.get("comments") or [{}])[0]
        opener = opening.get("author", "")
        if normalize_login(opener) != COPILOT_BOT:
            continue
        out.append({
            "id": entry.get("thread_id"),
            "path": entry.get("path") or "",
            "line": entry.get("line") if entry.get("line") is not None else "",
            "body": entry.get("opening_body") or "",
        })
    return out


# ---------------------------------------------------------------------------
# qlty
# ---------------------------------------------------------------------------

QLTY_BIN = Path.home() / ".qlty" / "bin" / "qlty"

# e.g.  path/to/file.py:12:3: error: message text
QLTY_LINE_RE = re.compile(r"^(.+?):(\d+):(\d+):\s+(error|warning|note|info):\s+(.+)$")

SEV_MAP = {
    "error": "high",
    "warning": "medium",
    "note": "low",
    "info": "low",
}


def get_pr_files(gh):
    """Return list of files changed in the PR."""
    try:
        return pr_files(gh, None)
    except GhError:
        return []


def run_qlty(files):
    """Return dict {high: [...], medium: [...], low: [...]} of issues."""
    if not QLTY_BIN.exists():
        return None
    if not files:
        return {"high": [], "medium": [], "low": []}
    result = subprocess.run(  # nosec B603 - QLTY_BIN is a fixed local path, files are repo-relative
        [str(QLTY_BIN), "check", *files],
        capture_output=True,
        text=True,
    )
    issues = {"high": [], "medium": [], "low": []}
    for line in result.stdout.splitlines():
        m = QLTY_LINE_RE.match(line)
        if m:
            path, lineno, col, severity, msg = m.groups()
            bucket = SEV_MAP.get(severity, "low")
            issues[bucket].append({
                "path": path,
                "line": lineno,
                "col": col,
                "severity": severity,
                "message": msg,
            })
    return issues


# ---------------------------------------------------------------------------
# CI checks
# ---------------------------------------------------------------------------

def get_ci_checks(gh, pr_number):
    """Return list of check dicts as ``gh pr checks --json`` provides them."""
    try:
        return pr_checks(gh, pr_number)
    except GhError:
        return []


# ``bucket`` is the new field ``gh pr checks --json`` reports; ``state`` is the
# workflow-run state that predated it. Both are kept because a check row may
# arrive with either one — status checks (external CI reporting through the
# statuses API) still populate ``state`` but not ``bucket``.
_BUCKET_MAP = {
    "pass": "passed",
    "fail": "failed",
    "pending": "pending",
    "skipping": "skipped",
    "cancel": "cancelled",
}

_STATE_MAP = {
    "SUCCESS": "passed",
    "FAILURE": "failed",
    "TIMED_OUT": "failed",
    "STARTUP_FAILURE": "failed",
    "CANCELLED": "cancelled",
    "SKIPPED": "skipped",
    "NEUTRAL": "skipped",
    "IN_PROGRESS": "in_progress",
    "QUEUED": "pending",
    "PENDING": "pending",
    "WAITING": "pending",
    "REQUESTED": "pending",
    "COMPLETED": "passed",
}


def format_check_status(check):
    """Return display string for a check.

    ``gh pr checks --json`` now emits ``bucket`` (``pass``/``fail``/
    ``pending``/``skipping``/``cancel``) alongside ``state``. ``bucket`` is
    checked first because it is gh's normalised verdict; state is the fallback
    for rows that never carried a bucket (status checks). ``conclusion`` is a
    third fallback for callers that still pass the older shape.
    """
    bucket = (check.get("bucket") or "").lower()
    if bucket in _BUCKET_MAP:
        return _BUCKET_MAP[bucket]
    state = (check.get("state") or "").upper()
    if state in _STATE_MAP:
        return _STATE_MAP[state]
    conclusion = (check.get("conclusion") or "").upper()
    if conclusion in _STATE_MAP:
        return _STATE_MAP[conclusion]
    return (check.get("state") or check.get("conclusion") or "unknown").lower() or "unknown"


# ---------------------------------------------------------------------------
# Summary comment
# ---------------------------------------------------------------------------

def build_summary_comment(threads, qlty_issues, checks):
    """Build markdown summary comment text."""
    lines = ["## PR Assistant Summary\n"]

    # Copilot
    if threads is not None:
        lines.append(f"### Copilot: {len(threads)} unresolved conversations")
        for t in threads:
            snippet = (t["body"][:100] + "...") if len(t["body"]) > 100 else t["body"]
            lines.append(f"- `{t['path']}:{t['line']}` — {snippet}")
        lines.append("")

    # Qlty
    if qlty_issues is not None:
        h = len(qlty_issues["high"])
        m = len(qlty_issues["medium"])
        lo = len(qlty_issues["low"])
        lines.append(f"### Qlty: {h} high, {m} medium, {lo} low\n")

    # CI
    if checks:
        lines.append(f"### CI: {len(checks)} checks")
        for c in checks:
            lines.append(f"- {c.get('name', '?')}  {format_check_status(c)}")
        lines.append("")

    return "\n".join(lines)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="pr-assistant",
        description="Automated GitHub PR workflow management.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--create", dest="create", action="store_true", default=True)
    p.add_argument("--no-create", dest="create", action="store_false")
    p.add_argument("--resolve-copilot", dest="resolve_copilot", action="store_true", default=True)
    p.add_argument("--no-resolve-copilot", dest="resolve_copilot", action="store_false")
    p.add_argument("--check-qlty", dest="check_qlty", action="store_true", default=True)
    p.add_argument("--no-check-qlty", dest="check_qlty", action="store_false")
    p.add_argument("--check-ci", dest="check_ci", action="store_true", default=True)
    p.add_argument("--no-check-ci", dest="check_ci", action="store_false")
    p.add_argument("--update-summary", dest="update_summary", action="store_true", default=True)
    p.add_argument("--no-update-summary", dest="update_summary", action="store_false")
    p.add_argument("--base", default="main", metavar="BRANCH", help="Base branch for new PRs")
    p.add_argument("--title", default=None, metavar="TEXT", help="Override PR title")
    p.add_argument("--body", default=None, metavar="TEXT", help="Override PR description")
    p.add_argument("--dry-run", action="store_true", default=False, help="Preview without changes")
    return p


def _ensure_pr(gh, args):
    """Find or create PR; return (PR dict or None, exit code or None)."""
    pr = find_pr(gh)
    if pr is not None:
        return pr, None
    if not args.create:
        print("No PR found on current branch. Use --create to auto-create.", file=sys.stderr)
        return None, 1
    branch = _git("rev-parse", "--abbrev-ref", "HEAD")
    print(f"No PR found for branch '{branch}', creating...")
    pr = create_pr(gh, args.base, args.title, args.body, args.dry_run)
    if pr is None and not args.dry_run:
        print("Failed to create PR.", file=sys.stderr)
        return None, 1
    if args.dry_run:
        print(f"[DRY RUN] Would create PR from '{branch}' into '{args.base}'")
        return None, 0
    return pr, None


def _collect_qlty(gh, args):
    """Run qlty checks on PR files if enabled; return issues dict or None."""
    if not args.check_qlty:
        return None
    files = get_pr_files(gh)
    if files:
        return run_qlty(files)
    return {"high": [], "medium": [], "low": []}


def _display_summary(threads, qlty_issues, checks):
    """Print human-readable summary of threads, qlty issues, and CI checks."""
    print(f"Copilot: {len(threads)} unresolved conversations")
    for t in threads:
        snippet = (t["body"][:100] + "...") if len(t["body"]) > 100 else t["body"]
        loc = f"{t['path']}:{t['line']}" if t["line"] else t["path"]
        print(f"  {loc} -- {snippet}")

    print()
    if qlty_issues is None:
        print("Qlty: skipped (qlty not found or --no-check-qlty)")
    else:
        h, m, lo = len(qlty_issues["high"]), len(qlty_issues["medium"]), len(qlty_issues["low"])
        print(f"Qlty: {h} high, {m} medium, {lo} low")

    print()
    print(f"CI: {len(checks)} checks")
    for c in checks:
        print(f"  {c.get('name', '?'):<30} {format_check_status(c)}")
    print()


def _resolve_copilot_threads(gh, threads, args):
    """Resolve unresolved Copilot threads if enabled.

    ``resolve_thread`` raises ``GhError`` when the response payload does not
    confirm the thread as resolved. Each failure is reported per thread and the
    caller-visible "some failed" summary is preserved.
    """
    if not (args.resolve_copilot and threads):
        return
    print(f"Resolving {len(threads)} Copilot conversation(s)...", end=" ", flush=True)
    if args.dry_run:
        print()
        for t in threads:
            print(f"[DRY RUN] Would resolve thread {t['id']}")
        return
    any_failed = False
    for t in threads:
        try:
            resolve_thread(gh, t["id"])
        except GhError as exc:
            any_failed = True
            print(f"\n  Failed to resolve {t['id']}: {exc}", file=sys.stderr)
    print("some failed" if any_failed else "done")


def _post_summary_comment(gh, pr_number, threads, qlty_issues, checks, args):
    """Post or preview a summary comment on the PR."""
    if not args.update_summary:
        return
    comment = build_summary_comment(threads, qlty_issues, checks)
    print("Adding summary comment...", end=" ", flush=True)
    if args.dry_run:
        print()
        print(f"[DRY RUN] Would post comment:\n{comment}")
        return
    try:
        pr_comment(gh, pr_number, comment)
    except GhError as exc:
        print(f"failed: {exc}")
        return
    print("done")


def _update_pr_metadata(gh, pr_number, args):
    """Update PR title/body if provided."""
    if not (args.title or args.body):
        return
    if args.dry_run:
        if args.title:
            print(f"[DRY RUN] Would set PR title: {args.title}")
        if args.body:
            print(f"[DRY RUN] Would set PR body: {args.body[:80]}...")
        return
    try:
        pr_edit(gh, pr_number, title=args.title, body=args.body)
    except GhError as exc:
        print(f"PR edit failed: {exc}", file=sys.stderr)


def main():
    parser = build_parser()
    args = parser.parse_args()
    try:
        return _run(args)
    except GhError as exc:
        # One exit path for every GitHub failure (auth, timeout, GraphQL
        # errors, an incomplete fetch) instead of a traceback.
        print(f"pr-assistant: {exc}", file=sys.stderr)
        return 1


def _run(args):
    gh = client()
    owner, repo = resolve_owner_repo(gh)

    pr, exit_code = _ensure_pr(gh, args)
    if pr is None:
        return exit_code

    pr_number = pr["number"]
    print(f"\nPR #{pr_number}: {pr.get('headRefName', '?')} -> {pr.get('baseRefName', args.base)}")
    print(pr["url"])
    print()

    threads = fetch_copilot_threads(gh, owner, repo, pr_number)
    qlty_issues = _collect_qlty(gh, args)
    checks = get_ci_checks(gh, pr_number) if args.check_ci else []

    _display_summary(threads, qlty_issues, checks)
    _resolve_copilot_threads(gh, threads, args)
    _post_summary_comment(gh, pr_number, threads, qlty_issues, checks, args)
    _update_pr_metadata(gh, pr_number, args)

    print(f"\n{pr['url']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
