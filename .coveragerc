[run]
source = src
branch = True
omit =
    .venv/*
    tests/*
    */test_*.py
    setup.py
    # `python -m <pkg>` entry shims: a docstring, `from .cli import main`, and
    # an `if __name__ == "__main__"` guard that coverage already excludes.
    # The only measurable statement is the import itself, so a test here
    # asserts that Python can import a module — not that anything works.
    # Real entry-point coverage lives in the tests for each `cli.main`, and
    # `make bin-wrappers-check` verifies the wrappers actually dispatch.
    */__main__.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
show_missing = True
precision = 1

[html]
directory = htmlcov
