#!/usr/bin/env bash
# Block direct pushes to main/master: fast-forward, force, and delete alike.
# Deleting other branches is unaffected.
# Install: git config core.hooksPath .githooks  (or: make hooks)
set -euo pipefail

while read -r _local_ref _local_oid remote_ref _remote_oid; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      cat 1>&2 <<ERR
ERROR: Direct push to ${remote_ref#refs/heads/} is blocked.

Use a feature branch and open a pull request instead.
If you are in a worktree, push the worktree branch:
  git push -u origin HEAD

ERR
      exit 1
      ;;
  esac
done

exit 0
