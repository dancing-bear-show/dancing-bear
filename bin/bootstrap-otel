#!/usr/bin/env bash
#
# Bootstrap local OpenTelemetry collector for Claude Code telemetry.
# Uses Docker (via docker-compose.otel.yaml) — Colima or Docker Desktop required.
#
# Usage:
#   ./bin/bootstrap-otel           # Start the Docker collector
#   ./bin/bootstrap-otel --check   # Check current status
#   ./bin/bootstrap-otel --stop    # Stop the Docker collector
#
# Env var note:
#   The five vars below must be set in the shell that STARTS the claude process.
#   A common gotcha: tmux panes retain the environment snapshot from when the
#   tmux server started. Exporting vars in a running pane does NOT propagate to
#   an already-running claude process in that pane. The vars only apply to
#   processes started after the export. Fix: run `tmux kill-server` and open a
#   fresh session (or re-export in every existing pane before relaunching claude).
#
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

GRPC_PORT="${OTEL_GRPC_PORT:-4327}"
COMPOSE_FILE="${SCRIPT_DIR}/docker-compose.otel.yaml"

CHECK_ONLY=false
STOP=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --check) CHECK_ONLY=true; shift ;;
        --stop)  STOP=true; shift ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

info()    { echo -e "${BLUE}→${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
warn()    { echo -e "${YELLOW}⚠${NC} $*"; }
error()   { echo -e "${RED}✗${NC} $*"; }

check_docker() {
    if ! command -v docker &>/dev/null; then
        error "docker not found. Install Docker Desktop or Colima."
        return 1
    fi
    if ! docker info &>/dev/null 2>&1; then
        error "Docker daemon is not reachable. Start Colima (colima start) or Docker Desktop."
        return 1
    fi
    return 0
}

check_status() {
    echo ""
    echo "OTel Collector Status"
    echo "─────────────────────"

    if ! command -v docker &>/dev/null; then
        warn "docker not found"
    elif ! docker info &>/dev/null 2>&1; then
        warn "Docker daemon not reachable (Colima stopped?)"
    else
        # Check whether this repo's collector container is running
        if docker compose -f "$COMPOSE_FILE" ps --status running 2>/dev/null | grep -q "otel-collector"; then
            success "Docker collector container is running"
        else
            warn "Docker collector container is NOT running (run: ./bin/bootstrap-otel)"
        fi
    fi

    echo ""
    echo "Environment:"
    if [[ "${CLAUDE_CODE_ENABLE_TELEMETRY:-}" == "1" ]]; then
        success "  CLAUDE_CODE_ENABLE_TELEMETRY=1"
    else
        warn "  CLAUDE_CODE_ENABLE_TELEMETRY not set (required)"
    fi
    if [[ "${OTEL_METRICS_EXPORTER:-}" == "otlp" ]]; then
        success "  OTEL_METRICS_EXPORTER=otlp"
    else
        warn "  OTEL_METRICS_EXPORTER not set or not 'otlp'"
    fi
    if [[ "${OTEL_LOGS_EXPORTER:-}" == "otlp" ]]; then
        success "  OTEL_LOGS_EXPORTER=otlp"
    else
        warn "  OTEL_LOGS_EXPORTER not set or not 'otlp'"
    fi
    if [[ "${OTEL_EXPORTER_OTLP_PROTOCOL:-}" == "grpc" ]]; then
        success "  OTEL_EXPORTER_OTLP_PROTOCOL=grpc"
    else
        warn "  OTEL_EXPORTER_OTLP_PROTOCOL not set or not 'grpc' (must be grpc, not http/protobuf)"
    fi
    local expected_endpoint="http://localhost:${GRPC_PORT}"
    if [[ "${OTEL_EXPORTER_OTLP_ENDPOINT:-}" == "$expected_endpoint" ]]; then
        success "  OTEL_EXPORTER_OTLP_ENDPOINT=${expected_endpoint}"
    else
        warn "  OTEL_EXPORTER_OTLP_ENDPOINT not set or incorrect (expected: ${expected_endpoint})"
    fi
    echo ""
}

if $STOP; then
    info "Stopping OTel collector (this repo only)..."
    if ! check_docker; then
        exit 1
    fi
    docker compose -f "$COMPOSE_FILE" down
    success "Collector stopped"
    exit 0
fi

if $CHECK_ONLY; then
    check_status
    exit 0
fi

echo ""
echo -e "${BLUE}Bootstrap: OpenTelemetry Collector (Docker)${NC}"
echo "────────────────────────────────────────────"
echo ""

info "Checking Docker..."
if ! check_docker; then
    exit 1
fi
success "Docker daemon reachable"

info "Starting OTel collector container..."
docker compose -f "$COMPOSE_FILE" up -d
success "Collector started"

echo ""
echo -e "${GREEN}Setup complete!${NC}"
echo ""
echo "Add these vars to your shell profile (e.g. ~/.zshrc) and restart your"
echo "shell — or export them in the pane where you launch claude:"
echo ""
echo "  export CLAUDE_CODE_ENABLE_TELEMETRY=1"
echo "  export OTEL_METRICS_EXPORTER=otlp"
echo "  export OTEL_LOGS_EXPORTER=otlp"
echo "  export OTEL_EXPORTER_OTLP_PROTOCOL=grpc"
echo "  export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:${GRPC_PORT}"
echo ""
echo "Note: OTEL_GRPC_PORT=${GRPC_PORT} (from current shell; 4327 is the default)."
echo "Use the same value in the shell that ran 'docker compose up' and the one"
echo "that runs claude. Never use the HTTP port (4328) as the OTLP endpoint."
echo ""
echo "Next steps:"
echo "  1. Export the vars above (or verify ~/.zshrc already has them)"
echo "  2. Restart Claude Code (or open a new terminal) to activate env vars"
echo "  3. Watch data land:  tail -f \${HOME}/.config/otel/events.jsonl | jq '.'"
echo "  4. Check status:     ./bin/bootstrap-otel --check"
echo "  5. Stop collector:   ./bin/bootstrap-otel --stop"
